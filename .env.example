# ============================================================================
# ParcelPilot — environment template
# Copy this file to .env.local and fill in real values. .env.local is gitignored.
# ============================================================================

# ---- Supabase --------------------------------------------------------------
# From Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_JWT
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_JWT

# Newer-format publishable + secret keys (optional; the JWTs above are enough).
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ---- Gemini (Google AI Studio) ---------------------------------------------
# Create a free-tier API key at https://aistudio.google.com/apikey
# gemini-2.0-flash is the Decider in the ADK sidecar + the fallback path.
# gemini-2.0-flash-lite is the Evaluator — different model breaks LLM-grades-LLM symmetry.
GEMINI_API_KEY=YOUR_GEMINI_KEY
GEMINI_MODEL=gemini-2.0-flash
GEMINI_PROJECT_NUMBER=

# ---- Resend (email) --------------------------------------------------------
# https://resend.com/api-keys
# The default sender onboarding@resend.dev only delivers to the Resend
# account owner's verified inbox until you add your own domain.
RESEND_API_KEY=YOUR_RESEND_KEY
RESEND_FROM_EMAIL=ParcelPilot <onboarding@resend.dev>

# ---- App ------------------------------------------------------------------
# Public URL where the app is reachable; used to build customer form links in emails.
APP_BASE_URL=http://localhost:3000

# 32+ random bytes. Signs cookies and hashes customer form tokens.
# Generate one: `openssl rand -hex 32`
CUSTOMER_FORM_TOKEN_SECRET=change-me-to-a-32-byte-random-string

# ---- ADK Agent Sidecar (Google ADK + A2A) ---------------------------------
# The Python FastAPI service in `agent_service/` runs the multi-agent brain.
# Start it with:  cd agent_service && uvicorn main:app --port 8787
AGENT_SERVICE_URL=http://localhost:8787
AGENT_SERVICE_TOKEN=dev-shared
